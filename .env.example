# Copy this file to .env and fill in exactly ONE provider block.
# There is no default provider — the agent will refuse to run the narrative
# step until LLM_PROVIDER and its matching API key are set.

# Which provider to use: openai | deepseek | qwen
LLM_PROVIDER=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- DeepSeek (OpenAI-compatible endpoint) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Qwen / Alibaba DashScope (OpenAI-compatible endpoint) ---
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# Optional: override any provider's base_url (e.g. a self-hosted proxy)
# LLM_BASE_URL_OVERRIDE=
